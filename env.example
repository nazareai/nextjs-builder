# Next.js & Tailwind Website Builder Configuration

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default Settings
NEXTJS_BUILDER_DEFAULT_TEMPLATE=general
NEXTJS_BUILDER_OUTPUT_DIR=./website
NEXTJS_BUILDER_VERBOSE=false

# LLM Settings
NEXTJS_BUILDER_LLM_MODEL=anthropic/claude-3.5-sonnet-20240620
NEXTJS_BUILDER_LLM_TEMPERATURE=0.7
NEXTJS_BUILDER_LLM_MAX_TOKENS=10000